cabal-version:      3.0
name:               uhhhhh
version:            0.1.0.0
synopsis:           A new Haskell project
license:            BSD-3-Clause
license-file:       LICENSE
author:             Haskell Developer
category:           Development
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable uhhhhh
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >= 4.14 && < 5,
        gloss >=1.13.0.1,
        AsyncRattus >= 0.2
    hs-source-dirs:   app
    default-language: GHC2021

test-suite uhhhhh-test
    import:           warnings
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base >= 4.14 && < 5,
        gloss >=1.13.0.1,
        AsyncRattus >= 0.2
